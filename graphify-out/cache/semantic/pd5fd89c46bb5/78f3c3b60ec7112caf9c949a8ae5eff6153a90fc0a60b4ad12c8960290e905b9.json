id": "docs_prd_prd_janela_votacao", "label": "Conceito: Janela de vota\u00e7\u00e3o", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "\u00a75.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_prd_apuracao", "label": "Conceito: Apura\u00e7\u00e3o manual", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "\u00a75.4, \u00a75.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_prd_anonimato_logico", "label": "Princ\u00edpio: Anonimato l\u00f3gico (Voto/Participacao separados)", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "\u00a78.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separa\u00e7\u00e3o entre Participacao e Voto garante que se saiba quem votou, nunca em quem. Timestamps arredondados (5 min) impedem correla\u00e7\u00e3o por hor\u00e1rio."}, {"id": "docs_prd_prd_setor_guarda_chuva", "label": "Princ\u00edpio: Agrupamento (setor guarda-chuva)", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "\u00a75.1, \u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setores com menos servidores que o limite m\u00ednimo s\u00e3o agrupados num setor guarda-chuva para mitigar quebra de anonimato em setores pequenos."}, {"id": "docs_prd_prd_empate_regra", "label": "Princ\u00edpio: Empate nunca resolvido pelo sistema", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "\u00a75.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O sistema apenas sinaliza o empate; o crit\u00e9rio (maior tempo de servi\u00e7o, sorteio, comiss\u00e3o) deve estar no regulamento antes da abertura."}, {"id": "docs_prd_prd_idempotencia_voto", "label": "Princ\u00edpio: Voto idempotente e irrevers\u00edvel", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Um voto por eleitor por edi\u00e7\u00e3o; irrevers\u00edvel ap\u00f3s confirma\u00e7\u00e3o; janela validada no submit."}, {"id": "docs_prd_prd_comprovante_pdf", "label": "Princ\u00edpio: Comprovante PDF sem nome do votado", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "\u00a76, \u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PDF cont\u00e9m bras\u00e3o, nome da premia\u00e7\u00e3o, edi\u00e7\u00e3o, setor, timestamp e hash; nunca o nome do candidato votado."}, {"id": "docs_prd_prd_escopo_setor_backend", "label": "Princ\u00edpio: Escopo por setor validado no backend", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "\u00a75.1, \u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O backend \u00e9 a \u00fanica fonte de verdade sobre quais candidatos o eleitor pode ver/votar; nunca confiar s\u00f3 no front."}, {"id": "docs_prd_prd_arredondamento_timestamp", "label": "Princ\u00edpio: Timestamps arredondados (janela 5 min)", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "\u00a74, \u00a78.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impede correla\u00e7\u00e3o por hor\u00e1rio entre Participacao e Voto."}, {"id": "docs_prd_prd_enquete_ws_anterior", "label": "Conceito: enquete-ws (projeto anterior reaproveitado)", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_prd_prd", "target": "docs_prd_prd_edicao", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PRD.md", "source_location": "\u00a74", "weight":